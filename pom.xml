<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.odm</groupId>
    <artifactId>odm</artifactId>
    <version>0.3.1</version>
    <packaging>pom</packaging>
    <name>odm</name>
    <description>A full featured native download manager for Linux based on aria2, yt-dlp and httrack</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.plugin.version>3.11.0</maven.compiler.plugin.version>
        <maven.assembly.plugin.version>3.6.0</maven.assembly.plugin.version>
        <maven.source.plugin.version>3.3.0</maven.source.plugin.version>
        <maven.javadoc.plugin.version>3.5.0</maven.javadoc.plugin.version>
        <jdeb.plugin.version>1.10</jdeb.plugin.version>
        <rpm.maven.plugin.version>2.2.0</rpm.maven.plugin.version>
        <exec.maven.plugin.version>3.1.0</exec.maven.plugin.version>
        <native.maven.plugin.version>0.9.23</native.maven.plugin.version>
        <slf4j.version>2.0.16</slf4j.version>
        <logback.version>1.5.12</logback.version>
        <test.excludedGroups>performance</test.excludedGroups>
        <test.suite>unit</test.suite>
        <!-- One selection shared by the regular exclusions and integration includes. -->
        <test.integration.includes>**/*IntegrationTest*.java,**/*E2ETest*.java,**/ProxychainsClientTest.java,**/TorToolManagerTest.java,**/CurlUtilsTest.java,**/ValidateTests.java</test.integration.includes>
    </properties>

    <modules>
        <!-- <module>odm-lib</module> -->
        <module>core</module>
        <module>odm-gtk4</module>
        <!--<module>examples</module>-->
        <!--<module>gladedemo</module>-->
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.2</version>
                    <configuration>
                        <excludedGroups>${test.excludedGroups}</excludedGroups>
                        <reportsDirectory>${project.build.directory}/surefire-reports/${test.suite}</reportsDirectory>
                        <excludes>
                            <!-- JUnit discovers @Nested tests through their outer class. -->
                            <exclude>**/*$*</exclude>
                            <exclude>${test.integration.includes}</exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>integration</id>
            <properties>
                <test.suite>integration</test.suite>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>${test.integration.includes}</include>
                            </includes>
                            <excludes combine.self="override">
                                <exclude>**/*$*</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>perf</id>
            <properties>
                <test.excludedGroups></test.excludedGroups>
                <test.suite>performance</test.suite>
                <!-- Benchmark timings must not include coverage instrumentation;
                     a benchmark-only run cannot satisfy the full coverage gate. -->
                <jacoco.skip>true</jacoco.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>performance</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
